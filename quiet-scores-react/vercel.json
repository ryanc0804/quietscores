{
  "rewrites": [
    {
      "source": "/fotmob/:path*",
      "destination": "https://www.fotmob.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "x-vercel-json-read", "value": "yes" }]
    }
  ]
}
