{
  "buildCommand": "cd quiet-scores-react && npm install && npm run build",
  "outputDirectory": "quiet-scores-react/dist",
  "installCommand": "cd quiet-scores-react && npm install",
  "rewrites": [
    {
      "source": "/fotmob/:path*",
      "destination": "https://www.fotmob.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "x-vercel-json-read", "value": "yes" }]
    }
  ]
}

